MAPS4U_DATA_DIR=./var
MAPS4U_DB_PATH=./var/maps4u.sqlite3
MAPS4U_ARTIFACT_DIR=./var/jobs
MAPS4U_CACHE_DIR=./var/osm_cache
MAPS4U_STYLE_DIR=./styles
MAPS4U_DEFAULT_STYLE=mcy/v1
MAPS4U_MIN_FONT_MM=1.5
MAPS4U_OVERPASS_URL=https://overpass-api.de/api/interpreter
MAPS4U_OVERPASS_MAX_CONCURRENCY=1
MAPS4U_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAPS4U_CACHE_MAX_AGE_DAYS=0
MAPS4U_INSETS_ENABLED=true
MAPS4U_OPERATOR_TOKEN=
REDIS_URL=redis://localhost:6379/0
MAPS4U_QUEUE=inline
MAPS4U_RENDER_DPI=300
MAPS4U_LOG_LEVEL=INFO
MAPS4U_ENV=dev
