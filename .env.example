MAPS4U_DATA_DIR=/var/maps4u
MAPS4U_DB_PATH=/var/maps4u/maps4u.db
MAPS4U_ARTIFACT_DIR=/var/maps4u/jobs
MAPS4U_CACHE_DIR=/var/maps4u/osm_cache
MAPS4U_CONFIG_DIR=./config
MAPS4U_SCHEMA_DIR=./schemas
MAPS4U_STYLE_DIR=./styles
MAPS4U_DEFAULT_STYLE=mcy/v1
MAPS4U_MIN_FONT_MM=1.5
MAPS4U_OVERPASS_URL=https://overpass-api.de/api/interpreter
MAPS4U_OVERPASS_TIMEOUT_S=120
MAPS4U_OVERPASS_MAX_CONCURRENCY=1
MAPS4U_CACHE_MAX_AGE_DAYS=30
MAPS4U_INSETS_ENABLED=true
# Production requires unique >=16-character secrets (generate via: openssl rand -hex 32).
# Known fallback tokens (e.g., maps4u-prod-operator-token, change-me) are rejected.
# Rotate tokens by updating env vars and restarting API/worker containers.
MAPS4U_OPERATOR_TOKEN=
MAPS4U_REVIEWER_TOKEN=
MAPS4U_OPERATOR_IDENTITY=operator
MAPS4U_REVIEWER_IDENTITY=reviewer
MAPS4U_STRICT_STARTUP=false
MAPS4U_REDIS_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
MAPS4U_QUEUE=inline
MAPS4U_RENDER_DPI=300
MAPS4U_LOG_LEVEL=INFO
MAPS4U_ENV=dev
